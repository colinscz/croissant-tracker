# Croissant Tracker — copy to `.env` and fill in.
#
# Used by docker-compose.yml (production) and docker-compose.dev.yml (local).
# The defaults below are for LOCAL DEVELOPMENT:
#   docker compose -f docker-compose.dev.yml up -d && pnpm db:migrate && pnpm dev
# For a server, follow docs/self-hosting-hetzner.md and replace every value.
#
# Generate passwords/secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Public URLs -------------------------------------------------------------
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
AUTH_DOMAIN=auth.localhost
HANKO_PUBLIC_URL=http://localhost:8000
# Let's Encrypt account email (production / Caddy only)
ACME_EMAIL=admin@example.com

# --- PostgreSQL --------------------------------------------------------------
# Only read when the database volume is first created (docker/postgres/init).
POSTGRES_PASSWORD=change-me-superuser
CROISSANT_OWNER_PASSWORD=change-me-owner
CROISSANT_APP_PASSWORD=change-me-app
HANKO_DB_PASSWORD=change-me-hanko

# --- Hanko -------------------------------------------------------------------
# Signs session tokens. At least 16 characters. Changing it signs everyone out.
HANKO_SECRET_KEY=change-me-at-least-16-characters
# HANKO_VERSION=v3.1.2

# --- Email (sign-in passcodes) -----------------------------------------------
# Local dev: Mailpit catches everything (http://localhost:8025).
# Production: a transactional email provider on port 587 — Hetzner blocks
# outbound 25 and 465 on new accounts.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=croissants@example.com
SMTP_FROM_NAME=Croissant Tracker

# --- Running Nuxt directly on the host (`pnpm dev` / `pnpm start`) -------------
# Not used by Docker Compose, which builds these from the values above.
NUXT_DATABASE_URL=postgres://croissant_app:change-me-app@localhost:5432/croissant
NUXT_PUBLIC_HANKO_API_URL=http://localhost:8000
DATABASE_OWNER_URL=postgres://croissant_owner:change-me-owner@localhost:5432/croissant
